# ============================================================
# CIMHANS Mental Health System — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# ===== Database =====
POSTGRES_DB=mental_health_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===== JWT (minimum 256-bit secret) =====
JWT_SECRET=CHANGE_ME_YOUR_VERY_LONG_JWT_SECRET_KEY_MIN_32_CHARS_PLEASE_CHANGE_THIS

# ===== AES-256 Encryption (exactly 16 chars for padding to 32) =====
ENCRYPTION_KEY=CHANGE_ME_16CHAR

# ===== Email (Gmail SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===== Application =====
FRONTEND_URL=http://localhost
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===== File Upload =====
UPLOAD_DIR=/app/uploads/
